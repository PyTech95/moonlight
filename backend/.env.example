# --- Required ---------------------------------------------------------------
APP_MODE=production                       # demo = staging with demo logins; production = live site
PRODUCTION_ORG_ID=moonlight-gurugram      # any fixed id; never change it after go-live
MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net
DB_NAME=moonlight
WEB_ORIGIN=https://moonlightneurocare.com
EXTRA_ALLOWED_ORIGINS=https://www.moonlightneurocare.com
DATA_ENCRYPTION_KEY=                      # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  KEEP SAFE, never regenerate
WEBHOOK_CRON_SECRET=                      # long random string; used by the two scheduled jobs

# --- Uploads ------------------------------------------------------------------
STORAGE_BACKEND=s3                        # emergent | s3 | local
S3_BUCKET=moonlight-media
S3_REGION=ap-south-1
S3_ENDPOINT_URL=                          # blank for AWS; set for Cloudflare R2 / DigitalOcean Spaces
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# STORAGE_DIR=/var/lib/moonlight/storage  # only for STORAGE_BACKEND=local
# EMERGENT_LLM_KEY=                       # only when hosting on Emergent (STORAGE_BACKEND=emergent)
MALWARE_SCAN=required                     # required | optional | off  (install ClamAV for "required")

# --- Optional -----------------------------------------------------------------
# PREVIEW_PROXY_ORIGIN=                   # Emergent preview proxy only
# GOOGLE_PLACES_API_KEY=                  # Google reviews block
# GOOGLE_PLACES_PLACE_ID=
# GOOGLE_MAPS_URL=
# DAILY_API_KEY=                          # online video classes
# DAILY_DOMAIN=
